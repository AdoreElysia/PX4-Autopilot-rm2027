#!/bin/sh
#
# board specific extras init
#------------------------------------------------------------------------------
#
# 本板：rm2027/fmu-h743
#
# 模板板的 atxxxx（MAX7456 模拟 OSD）本板没有，已移除。
# 本板 SPI2/SPI3 空闲且未引出片选，暂不挂任何外设。
#
# DShot 遥测：本板 4 路 ESC 各有一路独立串口
#   ESC1=UART4  ESC2=USART6  ESC3=UART7  ESC4=UART8
# 具体 /dev/ttySx 编号需按 defconfig 的 UART 使能顺序核对（见开发日志 Q-08）。

# ==================== 临时诊断：H104 协议抓包 ====================
# ⚠️ 用完必须删掉（见 work/spi-runtime/H104-完整帧抓取方案.md）
# 结果写在固定 RAM 里，用 ST-Link 按符号 dump（不走 console，本板 console 只有 4KB）：
#   g_h104_report[] / g_h104_report_len   —— 人类可读报告
#   g_h104_cap_buf[] / g_h104_cap_len     —— 原始字节流
# 用 & 后台跑，别挡住 PX4 启动。
sleep 3
h104cap all &
# ================================================================
