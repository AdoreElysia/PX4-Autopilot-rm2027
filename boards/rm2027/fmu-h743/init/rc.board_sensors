board_adc start

# ICM-42688-P gyro/accel  —— 原理图：SPI1 For ICM 42688（GYRO）
# TODO(pins): -b 1 是占位；真实 SPI 总线号取决于 src/spi.cpp 里的总线声明顺序
# TODO(pins): -R 0 是占位；真实值取决于 IMU 在 PCB 上的贴装方向
icm42688p -s -b 1 -R 0 start

# IST8310 magnetometer   —— 原理图：IIC4 For IST8310（Mag）
# TODO(pins): -b 4 是占位；PX4 的 I2C 总线号是「声明顺序」，不等于外设编号 IIC4
ist8310 -X -b 4 -R 0 start

# SPA06-003 barometer    —— 原理图：IIC2 For SPA06(Baro)
# TODO(pins): -b 2 同样是占位
spa06 -I -b 2 start

