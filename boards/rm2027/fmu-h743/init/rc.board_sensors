#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------
#
# 本板：rm2027/fmu-h743
#
# ⚠️ 跨端提醒：本文件是 Linux/NuttX 侧执行的 shell 脚本，行尾必须是 LF。
#
# 器件与地址的唯一基准 = 器件手册：
#   磁罗盘 = iSentek IST8310，I2C4（PD12/PD13），7bit 地址 0x0C
#     §6.1.1 地址表：CAD1=CAD0=VSS ⇒ 7bit = 0CH；§6.4.2 WAI(0x00) = 0x10
#     ⚠️ 必须显式 -a 0x0C：驱动缺省 0x0E；且 0x0C~0x0F 那圈只写软复位、不读
#     ⚠️ 必须 -I（internal）：本板一条 external 总线都没有 ⇒ -X 命不中
#   气压计 = Goertek SPA06，I2C2（PB10/PB11），7bit 地址 0x77
#     驱动缺省 0x76 ⇒ 必须显式 -a 0x77
#------------------------------------------------------------------------------

board_adc start

ist8310 -I -b 4 -a 0x0C -R 0 start

spa06 -I -b 2 -a 0x77 start
