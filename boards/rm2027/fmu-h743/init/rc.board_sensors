#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------
#
# 本板：rm2027/fmu-h743
#
# ⚠️ 跨端提醒：本文件是 Linux/NuttX 侧执行的 shell 脚本，行尾必须是 LF。
#
# ★★★ 2026-09-30 实测确认（用户在 QGC MAVLink Console 逐条敲出来的，不是猜的）★★★
#
#   磁罗盘 = iSentek IST8310（**和原理图一致**），I2C4，7bit 地址 0x0C
#     ⚠️ 2026-09-30 晚重大更正：此前"实物是 AF9838、不是 IST8310"的结论【作废】。
#        唯一基准 = iSentek IST8310 数据手册 v1.2（references/硬件手册/）：
#          §6.4.2 WAI(0x00) Device ID = 0x10
#          §6.4.4 输出寄存器 0x03~0x08（DATAXL/DATAXH/DATAYL/DATAYH/DATAZL/DATAZH）
#          §6.1.1 地址表：CAD1=CAD0=VSS ⇒ 7bit = 0CH（0DH/0EH/0FH 是其它 CAD 组合）
#        ⇒ **0x0C 是 IST8310 的合法地址**，"0x0C ⇒ AF9838"这个推理不成立。
#        ⇒ 当年那次 `ist8310 -I -b 4` 报 WARN，而 WARN 只在 **-X** 路径出现，
#           -X 下不遍历 Internal 总线 ⇒ **根本没碰过 I2C4**，那次测试无效。
#        ⇒ 而 af9838.cpp 的 probe() **不校验 ID**（只确认 I2C 有应答）⇒ 它把 IST8310 认成了 AF9838。
#       af9838  -I -b 4 start            → 起得来，但读数是错的（标度/复位/自检三处与手册不符）
#       ist8310 -I -b 4 -a 0x0C start    → ✅ 起来了 ⇒ probe 读到 WAI==0x10 ⇒ 身份坐实
#                                           device_id Type=0x06(I2C:4 0x0C)，|B|=0.259 G（在标定窗口内）
#     ★ 2026-09-30 晚：已切换到 ist8310，下面那一行就是最终写法。
#       ⚠️ **必须带 `-a 0x0C`**：IST8310 驱动的缺省地址是 0x0E（ist8310_main.cpp:55），
#          而它的 probe() 【只在你给的地址上读 WAI】，0x0C~0x0F 那圈只用来写软复位、不用来读。
#          本片被 CAD1/CAD0 拉到 0x0C ⇒ 不传 -a 永远读不到（已实测：报 no instance started）。
#
#   气压计 = Goertek SPA06，I2C2，7bit 地址 0x77（驱动默认 0x76 ⇒ 必须显式 -a）
#       spa06 -I -b 2 -a 0x77 start      → spa06 #0 on I2C bus 2 address 0x77   ✅
#
#   IMU    = ★ 以厂商手册为唯一基准（2026-09-30 定稿）：
#           华轩阳（HXY）「ICM-42688P」六轴传感器模块。
#           - 器件识别：WHO_AM_I(0x01) 缺省 0x6A（手册 §5.1 / §4.1）；
#             ⚠️ 0x00【不是】寄存器 —— 手册 §4.1 的通用寄存器表从 0x01 开始，
#                所以旧口径"CHIP_ID(0x00)=0x00 ⇒ BMI270 兼容件"是错的。
#           - 驱动：src/drivers/imu/hxy/hxy42688p（命令名 hxy42688p），独立新建，
#             不共用 Bosch BMI270 驱动、不含微码上传、不碰 BMI270 的寄存器图
#             （本片没有 PWR_CONF(0x7C)、没有 CMD(0x7E)、FIFO 在 0x1C~0x21 而非 0x24~0x26/0x46~0x49）。
#           - 初始化按手册：§5.42 SOFT_RST(0x4A)=0xA5 + 50ms → §5.45 PWR_CTRL(0x7D)=0x0E + 10ms
#             → §5.44 通电稳定 250ms → §5.39 关断状态下写 GYR_CONF → 打开 → §5.37/§5.38/§5.40 量程/ODR
#             → §5.8 读 DATA_STAT(0x0B) 校验 ACC_CONF_ERR/GYR_CONF_ERR。
#           - 取数：查询方式轮询 0x0B~0x17，用 DATA_STAT 的 DRDY 位判新样本（手册 §3.2.1 + §5.8）。
#           依据：projects/competition/rm2027-drone/references/硬件手册/
#                 华轩阳HXY_ICM-42688P_六轴传感器模块_手册.pdf
#
# 引脚依据：firmware/fmu-h743/引脚映射-H743.md（原理图 V1.0 直读）
#   引脚经用户人工复核 100% 正确 —— 问题在**型号**，不在引脚。
#     IMU(HXY42688P)  SPI1  SCK=PB3  MISO=PA6  MOSI=PD7  CS=PB4  DRDY=PD6
#     AF9838          I2C4  SCL=PD12 SDA=PD13            @0x0C
#     SPA06-003       I2C2  SCL=PB10 SDA=PB11            @0x77
#------------------------------------------------------------------------------

board_adc start

# IMU: 华轩阳 HXY「ICM-42688P」on SPI1, CS=PB4(GYRO_CS), DRDY=PD6(GYRO_INT1)（见文件头）
# 驱动 = hxy42688p（独立驱动，按厂商手册 §5.42/§5.45/§5.44/§5.39 的顺序初始化）。
# 上电后可先看这条日志：DATA_STAT(0x0B) 的 ACC_CONF_ERR/GYR_CONF_ERR 必须都是 0（手册 §5.8）；
# 若打印出 "register 0x42 read back ..." 报错，说明 GYR_CONF 没写进去（已知风险点）。
# ★★ 2026-10-01：`-R` 从 0 定为 **6 (ROTATION_YAW_270)** —— 上板实测定出来的，不是猜的。
#
#   为什么：六面标定一直挂在 `[cal] accel 0 invalid X-axis`。审查确认六面判定**只看符号**
#   （accelerometer_calibration.cpp:222-273），与幅值/标度无关 ⇒ 是轴向问题。
#   于是拿 H104（已知好的第二路 IMU）当参照，在同一姿势下比两路的"面签名"：
#
#     姿势    H104（板子坐标系）        hxy（-R 0）              结论
#     ---------------------------------------------------------------------
#     1       重力在 +Z（倒扣）          重力在 +Z（倒扣）          Z 一致 ✓
#     2       重力在 −X（机头朝下）      重力在 −Y                  X/Y 串位
#     3       重力在 +Y（左侧朝下）      重力在 −X                  X/Y 串位
#
#   两次都指向同一个映射：`hxy发布 = YAW_90(板子)`：
#      板 +X → hxy +Y ，板 +Y → hxy −X ，板 +Z → hxy +Z
#   PX4 的语义（src/lib/conversion/rotation.h:177/192）：
#      ROTATION_YAW_90  : x' = −y, y' = x        ← 正是上面这个映射
#      ROTATION_YAW_270 : x' = y,  y' = −x       ← 它的逆
#   ⇒ 要把它转回板子坐标系，`-R` 填 **6 = ROTATION_YAW_270**。
#   加计与陀螺共用同一个 `config.rotation`（hxy42688p_main.cpp:59 → HXY42688P.cpp:90-91），
#   而两路本来就在同一颗 die 上 ⇒ 一次把加计和陀螺都摆正。
#
#   ⚠️ 待办：这一条要由"重跑六面标定能过"来最终验收；若仍有面失败，见 work/spi-runtime/ 的排查记录。
#   ⚠️ 另有未决项：姿势2那次 hxy 的 |a| 读到 35.9 m/s²（≈3.6g），H104 同刻 9.84 ——
#      可能是手在动（两条报文差 37 ms），也可能是该通道增益异常，**尚未定论**。
hxy42688p -s -b 1 -R 6 start

# 磁罗盘: iSentek IST8310 on I2C4 (PD12/PD13), 7bit 地址 0x0C
# ★ 实测确认（2026-09-30）：打成 af9838 起得来 —— 但那是**错驱动认错了芯片**，
#   af9838.cpp 的 probe() 不校验 ID（只确认 I2C 有应答）。
# ★ 必须是 -I（internal），不能是 -X（external）：
#   src/i2c.cpp 里 I2C4 是用 initI2CBusInternal(4) 声明的（板载器件）。
#   PX4 的 I2CBusIterator 在 -X 时只遍历 topology != Internal 的总线
#   （platforms/common/i2c.cpp: FilterType::ExternalBus + bus_topology_has_external），
#   本板一条 external/shared I2C 总线都没有 ⇒ 循环体一次都不执行
#   ⇒ 直接报 "no instance started (no device on bus?)"，**根本没碰过 I2C4**。
#   旁证：只有 -X 这条路会打印 WARN（platforms/common/i2c_spi_buses.cpp:766-772），
#   -I 打的是 ERROR —— 当年 ist8310 报的正是 WARN ⇒ **那次测试走的是 -X，无效**。
# ★ 所以"ist8310 起不来"从来没有被真正验证过。
#   正解 = 下面这一行（已实测通过）。
#   ⚠️ **必须带 `-a 0x0C`** —— IST8310 驱动缺省 0x0E，而 0x0C~0x0F 那圈只写软复位、不读。
#       实测：`ist8310 -I -b 4 start`        → ERROR no instance started（读的是 0x0E）
#             `ist8310 -I -b 4 -a 0x0C start` → ✅ device_id Type=0x06(I2C:4 0x0C)，|B|=0.259 G
# ⚠️ |B| 实测 0.259 G（≈26 µT）比中国地表 (~50 µT) 偏低约 2×，但已落进 lm_mag_fit 的
#    半径窗口 (0.2, 0.7) ⇒ 标定能跑通，真正的刻度由标定自己估。若 fitness 很差再回头查。
ist8310 -I -b 4 -a 0x0C -R 0 start

# 气压计: SPA06-003 on I2C2 (PB10/PB11)
# ★ 实测确认（2026-09-30）：器件在 0x77，而驱动默认 0x76 ⇒ **必须显式 -a 0x77**，
#   否则 probe 会去问 0x76、拿 NACK，报 "no instance started"。
spa06 -I -b 2 -a 0x77 start

# 外置陀螺 H104 (HiPNUC HI04M0) on USART1 = /dev/ttyS0
#   协议 HI91 定长 82 字节 / CRC-16/XMODEM，模块出厂 100 Hz @115200；
#   驱动发 sensor_gyro + sensor_accel（**同一个 device_id**），sensors 模块会自动
#   为这一对建 VehicleIMU（src/modules/sensors/sensors.cpp: InitializeVehicleIMU）。
#   解析器已把模块的 RFU 载体系换算成 PX4 的 FRD ⇒ -r 保持 0；
#   只有模块在机架上的贴装方向与"右前上"不符时才需要调 -r。
#   ⚠️ 放飞前必须解决：X/Y 正负方向尚未用实物转动验证（见 work/spi-runtime/H104-帧格式规格.md §8.2）
h104_imu start
