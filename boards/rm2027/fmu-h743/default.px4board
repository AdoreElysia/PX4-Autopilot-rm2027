CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"
CONFIG_BOARD_ARCHITECTURE="cortex-m7"
CONFIG_BOARD_SERIAL_TEL1="/dev/ttyS2"   # USART3（本板唯一空闲串口）
CONFIG_DRIVERS_ADC_BOARD_ADC=y
CONFIG_DRIVERS_BAROMETER_GOERTEK_SPA06=y
CONFIG_DRIVERS_DSHOT=y
# --- IMU（SPI1 / CS=PB4）-----------------------------------------------------
# ★ 2026-09-30 最终结论（唯一基准 = 厂商手册）：
#   实物 = 华轩阳（HXY）「ICM-42688P」六轴传感器模块，WHO_AM_I(0x01) = 0x6A；
#   手册 §4.1 通用寄存器表里【没有 0x00】这个地址（0x00 不是寄存器）。
#   驱动 = 新建的独立驱动 src/drivers/imu/hxy/hxy42688p（命令名 hxy42688p）：
#   不共用 Bosch BMI270 驱动、不上传微码、不碰 BMI270 的寄存器图。
#   依据：projects/competition/rm2027-drone/references/硬件手册/
#         华轩阳HXY_ICM-42688P_六轴传感器模块_手册.pdf
#   ⚠️ 硬上限：这些驱动要同时在 src/spi.cpp 里登记 devtype，
#      而 SPI_BUS_MAX_DEVICES == 6（platforms/common/include/px4_platform_common/spi.h:54，**不可覆盖**）
#      ⇒ SPI1 上最多只能挂 6 个型号。当前就是 6 个（下面 6 行 + spi.cpp 里对应 6 行），已满。
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42688P=y   # 原理图标的（实测 probe 失败）
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42605=y    # 0x75/0x42
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42670P=y   # 0x75/0x67
CONFIG_DRIVERS_IMU_INVENSENSE_ICM45686=y    # 0x72/0xE9（ID 寄存器都不同）
CONFIG_DRIVERS_IMU_HXY_HXY42688P=y          # 华轩阳 HXY「ICM-42688P」：WHO_AM_I(0x01)=0x6A（手册 §5.1）
CONFIG_DRIVERS_IMU_ST_LSM6DSV=y             # 0x0F/0x70（含 LSM6DSV16X）
CONFIG_DRIVERS_IMU_HIPNUC_H104=y            # 外置陀螺 H104 (HiPNUC HI04M0) on USART1 = /dev/ttyS0
# 被"6 个槽位"挤掉、想换的话把上面任意一行换成下面一行即可（同时改 src/spi.cpp）：
#   CONFIG_DRIVERS_IMU_BOSCH_BMI270=y           # 0x00/0x24（Bosch，首读需 dummy）—— 本板实物不是它
#   CONFIG_DRIVERS_IMU_INVENSENSE_MPU6000=y     # 0x75/0x68，但封装是 QFN24 4×4 ≠ 本板 14 脚 LGA
#   CONFIG_DRIVERS_IMU_INVENSENSE_ICM20602=y    # 0x75/0x12，封装 16 脚 3×3 ≠ 本板 14 脚 LGA
#   CONFIG_DRIVERS_IMU_INVENSENSE_ICM40609D=y   # 0x75/0x3B
#   CONFIG_DRIVERS_IMU_BOSCH_BMI088=y           # 需要 2 条 CS（本板只有 PB4 一条）⇒ 不可能
#   CONFIG_DRIVERS_IMU_INVENSENSE_IIM42652=y    # 0x75/0x6F（车规版 42688）
# --- 磁罗盘 -------------------------------------------------------------------
CONFIG_COMMON_MAGNETOMETER=y
# ★ 2026-09-30 实测：实物是 Voltafield AF9838 @I2C4 0x0C，不是 IST8310 @0x0E。
# 注意：CONFIG_COMMON_MAGNETOMETER=y 会 `select` 全部磁罗盘驱动
#       （src/drivers/magnetometer/Kconfig 里 AF9838/IST8310 都在 select 列表里）
#       ⇒ 这两颗**都会**被编进固件，`ist8310` 命令依然存在（敲了会 ERROR，正常）。
#       本行只是"显式声明板载件"，让配置自解释；删掉它 AF9838 也照样能编进去。
CONFIG_DRIVERS_MAGNETOMETER_VOLTAFIELD_AF9838=y
CONFIG_DRIVERS_PWM_OUT=y
CONFIG_DRIVERS_RC_INPUT=y
CONFIG_COMMON_TELEMETRY=y
CONFIG_MODULES_ATTITUDE_ESTIMATOR_Q=y
CONFIG_MODULES_BATTERY_STATUS=y
CONFIG_MODULES_COMMANDER=y
CONFIG_MODULES_CONTROL_ALLOCATOR=y
CONFIG_MODULES_DATAMAN=y
CONFIG_MODULES_EKF2=y
CONFIG_MODULES_EVENTS=y
CONFIG_MODULES_FLIGHT_MODE_MANAGER=y
CONFIG_MODULES_FW_ATT_CONTROL=y
CONFIG_MODULES_FW_LATERAL_LONGITUDINAL_CONTROL=y
CONFIG_MODULES_FW_MODE_MANAGER=y
CONFIG_MODULES_FW_RATE_CONTROL=y
CONFIG_MODULES_GYRO_CALIBRATION=y
CONFIG_MODULES_GYRO_FFT=y
CONFIG_MODULES_LAND_DETECTOR=y
CONFIG_MODULES_LANDING_TARGET_ESTIMATOR=y
CONFIG_MODULES_LOAD_MON=y
CONFIG_MODULES_LOCAL_POSITION_ESTIMATOR=y
CONFIG_MODULES_LOGGER=y
CONFIG_MODULES_MAG_BIAS_ESTIMATOR=y
CONFIG_MODULES_MANUAL_CONTROL=y
CONFIG_MODULES_MAVLINK=y
CONFIG_MODULES_MC_ATT_CONTROL=y
CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=y
CONFIG_MODULES_MC_POS_CONTROL=y
CONFIG_MODULES_MC_RATE_CONTROL=y
CONFIG_MODULES_NAVIGATOR=y
CONFIG_MODULES_RC_UPDATE=y
CONFIG_MODULES_SENSORS=y
CONFIG_MODULES_UXRCE_DDS_CLIENT=y
CONFIG_MODULES_VTOL_ATT_CONTROL=y
CONFIG_SYSTEMCMDS_ACTUATOR_TEST=y
CONFIG_SYSTEMCMDS_DMESG=y
CONFIG_SYSTEMCMDS_GPIO=y
CONFIG_SYSTEMCMDS_H104CAP=y
CONFIG_SYSTEMCMDS_HARDFAULT_LOG=y
CONFIG_SYSTEMCMDS_I2CDETECT=y
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_PERF=y
CONFIG_SYSTEMCMDS_REBOOT=y
CONFIG_SYSTEMCMDS_SYSTEM_TIME=y
CONFIG_SYSTEMCMDS_TOP=y
CONFIG_SYSTEMCMDS_TOPIC_LISTENER=y
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
CONFIG_ARCH_CHIP_STM32H7=y
